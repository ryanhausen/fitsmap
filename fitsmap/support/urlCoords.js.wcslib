// This global variable holds the current WCSSession instance
let wcsSession = null;
const INIT_ERROR = "WCSLIB not initialized";
const ORIGIN = 1;

// Replaced by python at build time
const is_ra_dec = _IS_RA_DEC;

function pad80(s) {
  if (s.length > 80) return s.slice(0, 80);
  return s.padEnd(80, " ");
}

function makeFitsHeader(cards) {
  const safeCards = [...cards];
  if (!safeCards.some(c => c.startsWith("END"))) {
        safeCards.push("END");
  }
  const joined = safeCards.map(pad80).join("");
  return joined;
}

function allocateUTF8(module, str) {
  const utf8 = new TextEncoder().encode(str + "\0"); // null-terminated
  const ptr = module._malloc(utf8.length);
  // Create a view into WASM memory at the allocated pointer
  const heapView = new Uint8Array(module.HEAPU8.buffer, ptr, utf8.length);
  heapView.set(utf8);
  return ptr;
}


class WcsSession {
  constructor(Module, fitsHeader) {
    this.Module = Module;
    this.headerPtr = allocateUTF8(Module, fitsHeader);
    this.raPtr = Module._malloc(8);
    this.decPtr = Module._malloc(8);
    this.xPtr = Module._malloc(8);
    this.yPtr = Module._malloc(8);
    const status = Module._getWcs(this.headerPtr);
    if (status !== 0) throw new Error("WCSLIB init failed: " + status);
  }

  pixToSky(x, y, origin = 0, target) {
    const x1 = origin === 0 ? x + 1 : x;
    const y1 = origin === 0 ? y + 1 : y;

    const status = this.Module._pix2sky(x1, y1, this.raPtr, this.decPtr);

    if (status !== 0) throw new Error("pix2sky failed: " + status);
    const output = target || { ra: 0, dec: 0 };
    output.ra = this.Module.getValue(this.raPtr, "double");
    output.dec = this.Module.getValue(this.decPtr, "double");
    return output;
  }

  skyToPix(ra, dec, origin = 0, target) {
    const status = this.Module._sky2pix(ra, dec, this.xPtr, this.yPtr);
    if (status !== 0) throw new Error("sky2pix failed: " + status);
    const output = target || { x: 0, y: 0 };
    let x = this.Module.getValue(this.xPtr, "double");
    let y = this.Module.getValue(this.yPtr, "double");
    if (origin === 0) {
      x -= 1;
      y -= 1;
    }
    output.x = x;
    output.y = y;
    return output;
  }

  free() {
    if (this.headerPtr) {
      this.Module._free(this.headerPtr);
      this.headerPtr = null;
    }
    ["raPtr", "decPtr", "xPtr", "yPtr"].forEach(key => {
      if (this[key]) {
        this.Module._free(this[key]);
        this[key] = null;
      }
    });
  }
}

// Ensure Module is available. It should be loaded by wcslib.js script tag before this file.
if (typeof Module !== 'undefined') {
    Module.onRuntimeInitialized = () => {
        // console.log("WCSLIB module loaded");
        fetch("js/header.txt").then(response => response.text()).then(text => {
            // console.log("FITS header loaded");
            const cards = text.split('\n');
            const fitsHeader = makeFitsHeader(cards);
            try {
                wcsSession = new WcsSession(Module, fitsHeader);
                // console.log("WCSLIB session initialized");
                let isReadyEvent = new Event("wcsIsReady");
                window.dispatchEvent(isReadyEvent);
            } catch (e) {
                console.error("WCS Session Init Error", e);
            }
        }).catch(err => console.log("Error loading FITS header:", err));
    };
} else {
    console.error("Module (WCSLIB) is not defined!");
}


// --- Original Interface Implementation ---

urlParam = function(name){
    // Parse parameters from window.location,,
    // e.g., .../index.html?zoom=8,
    // urlParam(zoom) = 8,
    var results = new RegExp('[\?&]' + name + '=([^&#]*)').exec(window.location.href);
    if (results==null){
        return null;
    }
    else{
        return decodeURI(results[1]) || 0;
    }
}

pixToSky = function(xy){
    if (!wcsSession) {
        console.warn(INIT_ERROR);
        // Fallback or throw? index.js might fail.
        // For simple usage like updating location bar maybe we can return [0,0]?
        return [0, 0];
    }

    let x, y;
    if (xy.hasOwnProperty('lng')){
        x = xy.lng;
        y = xy.lat;
    } else {
        x = xy[0];
        y= xy[1];
    }
    // WCSLIB pix2sky
    // Note: wcslib.js example uses pixToSky method on session
    const res = wcsSession.pixToSky(x, y, ORIGIN);
    return [res.ra, res.dec];
}

skyToPix = function(rd){
    if (!wcsSession) {
        console.warn(INIT_ERROR);
        return [0, 0];
    }
    const res = wcsSession.skyToPix(rd[0], rd[1], ORIGIN);
    return [res.x, res.y];
}

skyToLatLng = function(rd){
    var xy = skyToPix(rd);
    return L.latLng(xy[1], xy[0]);
}

panToSky = function(rd, zoom, map){
    var ll = skyToLatLng(rd)
    map.setZoom(zoom);
    map.panTo(ll, zoom);
}

panFromUrl = function(map){
    const doPan = () => {
         // Pan map based on ra/dec/[zoom] variables in location bar
        var ra = urlParam(is_ra_dec ? 'ra' : 'x');
        var dec = urlParam(is_ra_dec ? 'dec' : 'y');
        var zoom = urlParam('zoom') || map.getMinZoom();

        // Check explicitly for null or undefined, as urlParam returns null if not found
        // But urlParam implementation above returns 0 if regex match group 1 is empty or decodeURI is empty??
        // Wait, existing urlParam implementation:
        // return decodeURI(results[1]) || 0;
        // if results is null -> return null

        if ((ra !== null) && (dec !== null)) {
            // We need to parse float because urlParam returns string (or 0)
            // But wait, existing panFromUrl didn't parse float explicitly?
            // "panToSky([ra,dec], zoom, map)"
            // JS type coercion might handle start of array?
            // Let's be safe and parse
            panToSky([parseFloat(ra), parseFloat(dec)], parseInt(zoom), map);
        } else {
            // Pan to crval - we don't have crval global anymore!
            // We need to ask WCS session for reference value or center.
            // wcsSession doesn't expose crval easily unless we parse header or add accessor.
            // As a fallback, maybe just don't pan? Leaflet has default center.
            // Or use [0,0] if not ra/dec?
            // If we want to pan to CRVAL, we need to extract it.
            // For now, let's rely on map default center if url params missing.
            // Or we can query wcsSession for the reference point if we extended WCS Session.
            // But wcsSession in example only has pix2sky/sky2pix.
            // Let's skip explicit panning if no params, or pan to 0,0 (Leaflet default?)
        }
    };

    if (wcsSession) {
        doPan();
    } else {
        window.addEventListener("wcsIsReady", doPan);
    }
}

updateLocationBar = function(){
    if (!wcsSession) return;
    var rd = pixToSky(map.getCenter());
    //console.log(rd);
    var params = `${is_ra_dec ? "ra" : "x"}=` + rd[0].toFixed(7);
    params += `&${is_ra_dec ? "dec" : "y"}=` + rd[1].toFixed(7);
    params += '&zoom=' + map.getZoom();
    //console.log(params);
    var param_url = window.location.href.split('?')[0] + '?' + params;
    window.history.pushState('', '', param_url);
}

// Clean up
window.addEventListener("beforeunload", () => {
  if (wcsSession) {
    wcsSession.free();
    wcsSession = null;
  }
});
